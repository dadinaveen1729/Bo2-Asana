NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_NAME=BoostFlow

# Server-only. Needed by the due-soon digest cron (src/app/api/cron/due-soon-digest)
# to read tasks across every workspace, bypassing RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` -- set the
# same value here and in the Vercel project's env vars. See vercel.json.
CRON_SECRET=

# Already used by src/app/api/notifications/email; the due-soon digest reuses
# the same Brevo SMTP creds.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
